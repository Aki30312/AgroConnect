<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agroconnect.controller.LoginController">

    <center>
        <VBox spacing="12" alignment="CENTER" maxWidth="420">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="AgroConnect Login" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10" maxWidth="420">
                <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEmail" promptText="example@mail.com"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtPassword" promptText="Enter password"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Login as:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="roleCombo" prefWidth="220"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="lblStatus" text="" />

            <HBox spacing="10" alignment="CENTER">
                <Button text="Login" onAction="#handleLogin" prefWidth="90"/>
                <Button text="Clear" onAction="#handleClear" prefWidth="90"/>
            </HBox>

            <Separator/>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Register Farmer" onAction="#goToFarmerRegister" prefWidth="160"/>
                <Button text="Register Buyer" onAction="#goToBuyerRegister" prefWidth="160"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>