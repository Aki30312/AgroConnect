<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agroconnect.controller.BuyerController">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <Label text="Browse Products" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblStatus" text="Select a product to order."/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="0" right="12" bottom="12" left="12"/>
            </padding>


            <TableView fx:id="tableProducts" prefHeight="320">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colName" text="Product" prefWidth="220"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="120"/>
                    <TableColumn fx:id="colQuantity" text="Available" prefWidth="120"/>
                </columns>
            </TableView>

            <Separator/>


            <GridPane hgap="10" vgap="10">
                <Label text="Order Quantity:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtOrderQty" promptText="e.g. 2" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <Button text="Place Order" onAction="#handlePlaceOrder"/>
                    <Button text="Refresh" onAction="#handleRefreshProducts"/>
                    <Button text="Back" onAction="#goBackToDashboard"/>
                </HBox>
            </GridPane>

        </VBox>
    </center>

</BorderPane>