<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.agroconnect.controller.FarmerRegisterController">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <Label text="Farmer Registration" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblStatus" text=""/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="0" right="12" bottom="12" left="12"/>
            </padding>

            <GridPane hgap="10" vgap="10">
                <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtName" promptText="Your full name"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEmail" promptText="example@mail.com"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Password:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtPassword" promptText="Create password"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Phone:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPhone" promptText="e.g. 0912345678"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Location:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtLocation" promptText="e.g. Addis Ababa"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1">
                    <Button text="Register" onAction="#handleRegister"/>
                    <Button text="Back to Login" onAction="#goBackToLogin"/>
                </HBox>
            </GridPane>

        </VBox>
    </center>

</BorderPane>